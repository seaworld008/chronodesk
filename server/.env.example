# 服务器配置
PORT=8081
GIN_MODE=debug
ENVIRONMENT=development
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
# Comma-separated proxy IPs/CIDRs. Empty means forwarded client-IP headers are ignored.
TRUSTED_PROXIES=

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=chronodesk_runtime
DB_PASSWORD=chronodesk_runtime_dev_only
DB_NAME=chronodesk
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Shanghai
# 应用只长期持有非 owner、NOSUPERUSER、NOBYPASSRLS 的 runtime 连接。
DATABASE_RUNTIME_URL=postgres://chronodesk_runtime:chronodesk_runtime_dev_only@localhost:5432/chronodesk?sslmode=disable
# 仅 AUTO_MIGRATE=true 的短生命周期启动阶段读取迁移 URL；生产应用实例
# 应保持 AUTO_MIGRATE=false 且不注入该凭据。
DATABASE_MIGRATION_URL=
# 独立迁移/凭据维护命令读取以下 URL。生产优先使用非池化、TLS 连接；
# 本地开发可使用下面的回环 owner 示例。
DATABASE_URL=postgres://chronodesk:chronodesk_dev_only@localhost:5432/chronodesk?sslmode=disable
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=
# 仅供隔离测试网络显式放行远程形态的明文地址；共享/生产必须保持 false。
POSTGRES_ALLOW_INSECURE=false

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# 运行时只选择一种显式协调存储，不在连接失败时跨端点回退。
# 远程 TCP 必须使用 rediss://；redis:// 仅允许回环，或在一次性容器网络
# 中显式设置 REDIS_ALLOW_INSECURE=true。
REDIS_URL=redis://localhost:6379
REDIS_ALLOW_INSECURE=false
# Upstash REST 模式：URL 与写 Token 必须同时配置；只读 Token 仅供发布
# 连通性门禁使用。启用 REST 时请清空 REDIS_URL，避免配置歧义。
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# JWT 配置
# 人类访问/刷新密钥均须至少 32 个字符且彼此独立。issuer 固定为 APP_URL，
# audience 固定为 APP_URL/api，不提供旧协议覆盖项。
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=168h

# AI Agent / MCP / A2A 配置
AGENT_JWT_SECRET=replace-with-a-dedicated-agent-token-secret
AGENT_CREDENTIAL_PEPPER=replace-with-a-stable-dedicated-credential-pepper
AGENT_ISSUER=http://localhost:8081
# 三个 OAuth resource 固定由 APP_URL 派生：/mcp、/api/v2、/a2a/v1
AGENT_TOKEN_TTL=15m
AGENT_CREDENTIAL_TTL=2160h
# 附件正式存储默认使用本机私有目录；生产多副本时，本地正式目录和暂存
# 目录都必须位于共享 RWX/PVC。切换到 s3 后，上传仍先写本地共享暂存，
# 再由 Outbox Worker 迁移到私有对象桶。
AGENT_ATTACHMENT_STORAGE_BACKEND=local
AGENT_ATTACHMENT_LOCAL_STORE_ID=local-default
AGENT_ATTACHMENT_DIR=./data/agent-attachments
AGENT_ATTACHMENT_STAGING_DIR=./data/agent-attachment-staging
AGENT_ATTACHMENT_LOCAL_DEPLOYMENT_MODE=single
AGENT_MAX_ATTACHMENT_BYTES=26214400
# S3 兼容配置（AWS S3、MinIO 及提供 S3 API 的云对象存储）。AWS 可留空
# endpoint 并使用默认凭据链；MinIO 通常设置 endpoint、path-style 和专用
# 凭据。生产禁止明文 HTTP；桶必须保持私有且由桶策略配置静态加密。
AGENT_ATTACHMENT_S3_ENDPOINT=
AGENT_ATTACHMENT_S3_STORE_ID=s3-default
AGENT_ATTACHMENT_S3_REGION=us-east-1
AGENT_ATTACHMENT_S3_BUCKET=
AGENT_ATTACHMENT_S3_PREFIX=chronodesk/attachments
AGENT_ATTACHMENT_S3_USE_PATH_STYLE=false
AGENT_ATTACHMENT_S3_ALLOW_INSECURE=false
AGENT_ATTACHMENT_S3_ACCESS_KEY_ID=
AGENT_ATTACHMENT_S3_SECRET_ACCESS_KEY=
AGENT_ATTACHMENT_S3_SESSION_TOKEN=
# bucket-default | AES256 | aws:kms
AGENT_ATTACHMENT_S3_SSE=bucket-default
AGENT_ATTACHMENT_S3_KMS_KEY_ID=
# auto | required | disabled。启动时读取桶的版本控制状态；版本化对象必须
# 持久化并使用精确 VersionID 读取/删除。
AGENT_ATTACHMENT_S3_VERSIONING_MODE=auto
# 最多 8 个历史 S3 store。切换 bucket/prefix 时先把旧配置放入此注册表，
# 并给新 store 使用新的 store_id。JSON 可省略凭据以使用默认凭据链。
AGENT_ATTACHMENT_S3_HISTORICAL_STORES_JSON=[]
AGENT_LOOP_THRESHOLD=20
AGENT_LOOP_WINDOW=1m
AGENT_GLOBAL_READ_ONLY=false

# 项目知识库与模型网关。OpenSearch 是可重建投影；PostgreSQL 始终是权威源。
# 非回环明文连接仅允许隔离的开发网络显式开启，生产必须使用 HTTPS。
OPENSEARCH_URL=
OPENSEARCH_INDEX_PREFIX=chronodesk-knowledge
OPENSEARCH_SEARCH_PIPELINE=chronodesk-knowledge-hybrid
OPENSEARCH_VECTOR_DIMENSION=384
OPENSEARCH_ALLOW_INSECURE=false
# 可同时指向云端或内网本地统一 Model Gateway；URL 只能来自部署配置。
MODEL_GATEWAY_URL=
MODEL_GATEWAY_PROVIDER_KEY=default
MODEL_GATEWAY_EXTERNAL=true

# 集成入站 HMAC 密钥由部署注入，Connection 仅保存这里的引用。current /
# previous 均为 32-4096 字节随机密钥的标准 Base64；previous 可留空。
CHRONODESK_INTEGRATION_HMAC_KEYS_JSON=

# OpenTelemetry / Prometheus。未配置 OTLP endpoint 时仍传播 W3C Trace
# Context，但不发生任何遥测网络调用。认证头只从部署配置读取。
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_ALLOW_INSECURE=false
OTEL_TRACE_SAMPLING_RATIO=0.1
CHRONODESK_OTLP_HEADERS_JSON=
METRICS_ENABLED=true
# 生产开启 metrics 时必须是至少 32 字节的随机 Bearer Token；开发环境
# 留空时 /metrics 仅接受实际 loopback 客户端。
CHRONODESK_METRICS_BEARER_TOKEN=

# 平台审计 CSV 导出。当前仅支持本地文件适配器：单实例用 single；
# 多实例必须使用所有实例和 Worker 共享的 RWX 持久卷并显式设为 shared-rwx。
# 生产环境不会推断部署拓扑，必须明确设置模式、实例数、目录和稳定 Worker ID。
AUDIT_EXPORT_STORAGE_BACKEND=local
AUDIT_EXPORT_STORAGE_DIR=./data/audit-exports
AUDIT_EXPORT_LOCAL_DEPLOYMENT_MODE=single
# 整个 ChronoDesk 应用部署的副本数；审计导出据此验证本地卷拓扑。
CHRONODESK_REPLICA_COUNT=1
AUDIT_EXPORT_WORKER_ID=chronodesk-audit-export-1
AUDIT_EXPORT_POLL_INTERVAL=5s
AUDIT_EXPORT_CLEANUP_INTERVAL=15m

# 数据库敏感字段静态加密（生产环境必填）
# 主 key ID 用于新写入；JSON keyring 保留旧 key 可实现在线轮换。
# 每个 key 必须是随机生成的 32 字节值，再进行 Base64 编码。
# 两项均留空时，服务可从高熵 AGENT_CREDENTIAL_PEPPER 经 HKDF 域分离派生；
# 若只配置其中一项或格式错误，服务将直接启动失败。
CHRONODESK_DATA_ENCRYPTION_PRIMARY_KEY_ID=
CHRONODESK_DATA_ENCRYPTION_KEYS=

# SMTP、邮件模板与验证码主题由管理后台的加密 EmailConfig 统一管理，
# 不再提供无效的环境变量旁路。

# 限流配置
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW=1m
# 登录、注册、找回密码等匿名凭据写接口使用更严格的独立限流。
AUTH_IDENTITY_RATE_LIMIT_REQUESTS=20
AUTH_IP_RATE_LIMIT_REQUESTS=200
AUTH_RATE_LIMIT_WINDOW=1m

# CORS 配置
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With,Idempotency-Key,If-Match,X-Ticket-Lease,MCP-Protocol-Version,Mcp-Method,Mcp-Name,traceparent,tracestate,baggage,X-Correlation-ID

# 安全配置
# 允许范围 10-16；运行时严格使用该值，非法值会阻止服务启动。
BCRYPT_COST=12

# 应用配置
APP_NAME=ChronoDesk
APP_VERSION=0.3.0
APP_URL=http://localhost:8081
WEB_URL=http://localhost:3000

# 数据库连接池配置
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis 连接池配置
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_POOL_TIMEOUT=4s
REDIS_IDLE_TIMEOUT=5m
