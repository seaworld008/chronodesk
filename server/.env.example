# 服务器配置
PORT=8081
GIN_MODE=debug
ENVIRONMENT=development
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
# Comma-separated proxy IPs/CIDRs. Empty means forwarded client-IP headers are ignored.
TRUSTED_PROXIES=

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=chronodesk
DB_PASSWORD=chronodesk_dev_only
DB_NAME=chronodesk
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Shanghai

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=168h

# AI Agent / MCP / A2A 配置
AGENT_JWT_SECRET=replace-with-a-dedicated-agent-token-secret
AGENT_CREDENTIAL_PEPPER=replace-with-a-stable-dedicated-credential-pepper
AGENT_ISSUER=http://localhost:8081
# 三个 OAuth resource 固定由 APP_URL 派生：/mcp、/api/v1、/a2a/v1
AGENT_TOKEN_TTL=15m
AGENT_CREDENTIAL_TTL=2160h
AGENT_COMPATIBILITY_USER_ID=1
AGENT_ATTACHMENT_DIR=./data/agent-attachments
AGENT_MAX_ATTACHMENT_BYTES=26214400
AGENT_LOOP_THRESHOLD=20
AGENT_LOOP_WINDOW=1m
AGENT_GLOBAL_READ_ONLY=false

# 数据库敏感字段静态加密（生产环境必填）
# 主 key ID 用于新写入；JSON keyring 保留旧 key 可实现在线轮换。
# 每个 key 必须是随机生成的 32 字节值，再进行 Base64 编码。
# 两项均留空时，服务可从高熵 AGENT_CREDENTIAL_PEPPER 经 HKDF 域分离派生；
# 若只配置其中一项或格式错误，服务将直接启动失败。
CHRONODESK_DATA_ENCRYPTION_PRIMARY_KEY_ID=
CHRONODESK_DATA_ENCRYPTION_KEYS=

# 邮件配置 (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@chronodesk.local
SMTP_FROM_NAME=ChronoDesk

# OTP 配置
OTP_EXPIRES_IN=10m
OTP_LENGTH=6

# 限流配置
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW=1m
# 登录、注册、找回密码等匿名凭据写接口使用更严格的独立限流。
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW=1m

# 文件上传配置
UPLOAD_MAX_SIZE=10MB
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# CORS 配置
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With,Idempotency-Key,If-Match,X-Ticket-Lease,MCP-Protocol-Version,Mcp-Method,Mcp-Name

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# 安全配置
BCRYPT_COST=12
CSRF_SECRET=your-csrf-secret-key

# 应用配置
APP_NAME=ChronoDesk
APP_VERSION=0.1.0
APP_URL=http://localhost:8081
WEB_URL=http://localhost:3000

# 数据库连接池配置
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis 连接池配置
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5
REDIS_POOL_TIMEOUT=4s
REDIS_IDLE_TIMEOUT=5m

# 开发模式配置
DEBUG=true
ENABLE_SWAGGER=true
ENABLE_PPROF=false
