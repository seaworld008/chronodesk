{
  "name": "chronodesk-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "generate:human-api": "node ./scripts/generate-human-api-types.mjs",
    "check:human-api": "node ./scripts/generate-human-api-types.mjs --check",
    "test:human-api": "node ./scripts/test-human-api-contract.mjs",
    "audit:security": "node ./scripts/audit-security.mjs",
    "check": "npm run check:human-api && npm run test:human-api && npm run typecheck && npm run lint && npm run audit:security && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "9.2.0",
    "@mui/material": "9.2.0",
    "query-string": "^9.4.1",
    "ra-core": "^5.15.0",
    "ra-i18n-polyglot": "^5.15.0",
    "react": "^19.2.8",
    "react-admin": "^5.15.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
